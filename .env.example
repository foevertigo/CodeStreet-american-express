# =============================================================================
# FinTech AI Agent — Async Audit Pipeline & Databases
# Copy this to .env and fill in values before running docker compose up
# =============================================================================

# --- LLM Provider (Groq) & Voice (Sarvam) ---
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amex_agent
POSTGRES_USER=amex_user
POSTGRES_PASSWORD=amex_secure_pass_2024
POSTGRES_DSN=postgresql://amex_user:amex_secure_pass_2024@localhost:5432/amex_agent

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2024
REDIS_URL=redis://:redis_secure_pass_2024@localhost:6379/0
REDIS_SESSION_TTL_SECONDS=1800   # 30 minutes — sessions expire after inactivity

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181

# Kafka Topics — DO NOT CHANGE THESE, teammates reference them by name
KAFKA_TOPIC_AGENT_ACTIONS=agent-actions
KAFKA_TOPIC_COMPLIANCE_DECISIONS=compliance-decisions
KAFKA_TOPIC_CARD_EVENTS=card-events
KAFKA_TOPIC_SYSTEM_ERRORS=system-errors
KAFKA_TOPIC_ESCALATIONS=escalations

# Kafka producer settings
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_ACK=all   # Most durable: wait for all replicas

# --- Elasticsearch ---
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=amex-audit

# --- Kibana ---
KIBANA_PORT=5601

# --- Environment ---
ENVIRONMENT=development   # change to "production" for prod
LOG_LEVEL=INFO
